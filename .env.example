# ---- pool service ----
SPO_PORT=8788
SPO_HOST=0.0.0.0
SPO_MAX_WORKERS=8
SPO_PER_KEY_CONCURRENCY=16
SPO_ADMIN_TOKEN=change-me-please
SPO_MAX_SECONDS=30
SPO_XFADE=0
SPO_25_SEAM=1
SPO_AUTO_CLAIM=0
SPO_UPLOAD_COOLDOWN=30
SPO_STALE_SECS=1800
SPO_SWEEP_INTERVAL=900

# ---- local shard / client ----
SPO_MIN_CREDIT=80
PP_WIRE_RES=720p
PP_PORTS=0
# PP_FFPROBE=/usr/bin/ffprobe

# ---- pool access from shards ----
POOL_HOST=127.0.0.1
POOL_SSH_PORT=22
POOL_SSH_USER=root
POOL_SSH_PASSWORD=
POOL_DB=/opt/seedance-pool/src/server/data/pool.db
POOL_ADMIN_TOKEN=
POOL_API_KEY=

# ---- local paths ----
APP_DIR=./var
LOG_DIR=./logs
OUT_DIR=./outputs
